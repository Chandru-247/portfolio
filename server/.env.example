# ==========================================
# GALAXY PORTFOLIO BACKEND ENVIRONMENT CONFIG
# ==========================================

# Server Port
PORT=5000

# JWT Authentication Secret Key (replace with any secure random string)
JWT_SECRET=galaxy-portfolio-cosmic-secret-key-2026

# ==========================================
# MONGODB ATLAS CONFIGURATION
# ==========================================
# 1. Create a free M0 cluster on https://www.mongodb.com/cloud/atlas
# 2. Add a Database User (username & password)
# 3. Add IP Access: 0.0.0.0/0 (allow access from anywhere, required for Vercel)
# 4. Click "Connect" -> "Drivers" -> copy the connection string and paste below:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.your-cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# ==========================================
# CLOUDINARY CLOUD MEDIA STORAGE
# ==========================================
# 1. Create a free account at https://cloudinary.com
# 2. Go to your Dashboard / API Keys page
# 3. Copy your Cloud Name, API Key, and API Secret:
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: Cloudinary full URL format alternative
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ==========================================
# EMAIL NOTIFICATIONS (OPTIONAL - NODEMAILER)
# ==========================================
# App password for Gmail or custom SMTP
EMAIL_USER=itismechandru247@gmail.com
EMAIL_PASS=your_gmail_app_password
